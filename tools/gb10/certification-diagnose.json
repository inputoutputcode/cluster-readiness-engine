{
  "apiVersion": "nvcre.nvidia.com/v1alpha1",
  "kind": "Certification",
  "metadata": {"name": "gb10-diagnose", "namespace": "default"},
  "spec": {
    "target": {
      "nodeSelector": {"nvidia.com/gpu.product": "NVIDIA-GB10"}
    },
    "nodesPerJob": 8,
    "gpusPerNode": 1,
    "enableMNNVL": false,
    "image": "gb10-nccl:local",
    "nicResources": [
      {"name": "rdma/rdma_shared_device_a", "quantity": 1},
      {"name": "rdma/rdma_shared_device_b", "quantity": 1}
    ],
    "maxBytes": "1G",
    "numIterations": 20,
    "numCycles": 2,
    "categories": [
      {
        "domain": "communication",
        "variant": "nccl-all-reduce",
        "options": {
          "testScale": "diagnose",
          "minGroupSize": 2,
          "maxConcurrent": 1,
          "timeoutPerJob": "35m",
          "thresholds": {"busBandwidthGBps": "value >= 18"}
        }
      }
    ]
  }
}
