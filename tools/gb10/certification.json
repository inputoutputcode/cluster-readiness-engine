{
  "apiVersion": "nvcre.nvidia.com/v1alpha1",
  "kind": "Certification",
  "metadata": {"name": "gb10-cert", "namespace": "default"},
  "spec": {
    "target": {
      "nodeNames": ["spark-1ac4", "spark-38fc"],
      "nodeSelector": {"nvidia.com/gpu.product": "NVIDIA-GB10"}
    },
    "nodesPerJob": 2,
    "gpusPerNode": 1,
    "enableMNNVL": false,
    "image": "gb10-nccl:local",
    "nicResources": [
      {"name": "rdma/rdma_shared_device_a", "quantity": 1},
      {"name": "rdma/rdma_shared_device_b", "quantity": 1}
    ],
    "maxBytes": "1G",
    "numIterations": 20,
    "numCycles": 2,
    "categories": [
      {
        "domain": "diagnostics",
        "variant": "gb10-c2c",
        "options": {
          "maxConcurrent": 1,
          "thresholds": {
            "c2cCPUToGPUBandwidthGBps": "value >= 1",
            "c2cGPUToCPUBandwidthGBps": "value >= 1",
            "c2cVerified": "value >= 1"
          }
        }
      },
      {
        "domain": "communication",
        "variant": "nccl-all-reduce",
        "options": {"thresholds": {"busBandwidthGBps": "value >= 18"}}
      },
      {
        "domain": "communication",
        "variant": "nccl-alltoall"
      },
      {
        "domain": "training",
        "variant": "llama32-1b",
        "options": {
          "maxSteps": 50,
          "resources": {
            "limits": {"cpu": "20", "memory": "112Gi"},
            "requests": {"cpu": "8", "memory": "64Gi"}
          },
          "thresholds": {"goodputRatio": "value >= 0.95"}
        }
      }
    ]
  }
}
